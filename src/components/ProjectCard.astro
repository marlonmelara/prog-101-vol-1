---
// 1. Definimos qué datos necesita recibir este componente (Props)
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  tags: string[]; // Ejemplo: ['TS', 'HTML', 'CSS']
}

const { title, description, icon, href, tags } = Astro.props;

// 2. Función auxiliar para mapear el texto del tag a tu clase CSS modificadora
//    Ejemplo: si el tag es "TS", devuelve "tech-stack__item--ts"
const getTagClass = (tag: string) => {
  const lowerTag = tag.toLowerCase();

  // Diccionario de mapeo según tus estilos actuales
  const map: Record<string, string> = {
    'ts': 'tech-stack__item--ts',
    'typescript': 'tech-stack__item--ts',
    'js': 'tech-stack__item--js',
    'javascript': 'tech-stack__item--js',
    'html': 'tech-stack__item--html',
    'css': 'tech-stack__item--css',
    // Si agregas SASS o React en el futuro, los añades aquí
    'react': 'tech-stack__item--react',
  };

  // Si no encuentra el tag, devuelve una clase base (o vacía)
  return map[lowerTag] || '';
};
---

<article class="card">
  <a href={href} class="card__link">
    <div class="card__header">
      <span class="card__icon">{icon}</span>
      <h2 class="card__title">{title}</h2>
    </div>

    <p class="card__description">
      {description}
    </p>

    <div class="card__footer">
      <span class="card__label">Tech Stack</span>
      <ul class="tech-stack">
        {tags.map((tag) => (
          /* Renderizado dinámico de etiquetas */
          <li class={`tech-stack__item ${getTagClass(tag)}`}>
            {tag}
          </li>
        ))}
      </ul>
    </div>
  </a>
</article>

<style>
  /* No necesitamos CSS aquí porque todo viene de src/styles/bem-ui.css
     que ya cargamos en el MainLayout. ¡Limpieza total!
  */
</style>