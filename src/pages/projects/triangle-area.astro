---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Calculadora de Área de Triángulo">

  <header class="header">
    <a class="header__return-home" href="/">← HOME</a>
    <h1 class="header__title">Triangle Area Calculator</h1>
  </header>

  <main class="main">
    <form id="calculatorForm" class="form">

      <div class="form__content">

        <div class="form__group">
            <label for="baseInput" class="form__label">Base</label>
            <input
                type="number"
                id="baseInput"
                class="form__input"
                placeholder="Enter base"
                required
                min="0.1"
                step="0.1"
            />
        </div>

        <div class="form__group">
            <label for="heightInput" class="form__label">Height</label>
            <input
                type="number"
                id="heightInput"
                class="form__input"
                placeholder="Enter height"
                required
                min="0.1"
                step="0.1"
            />
        </div>

      </div>

      <div class="form__arrow" aria-hidden="true">↓</div>

      <button type="submit" class="form__button">Calculate Area</button>
    </form>

    <div
      class="main__result"
      id="resultOutput"
      role="status"
      aria-live="polite"
    ></div>
  </main>
</MainLayout>

<script>
  // LÓGICA DEL CLIENTE
  import { calculateTriangleArea } from '../../scripts/geometry';

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('calculatorForm') as HTMLFormElement;
  const baseInput = document.getElementById('baseInput') as HTMLInputElement;
  const heightInput = document.getElementById('heightInput') as HTMLInputElement;
  const resultOutput = document.getElementById('resultOutput') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Reseteamos estado visual
      resultOutput.textContent = '';
      resultOutput.style.backgroundColor = '';
      resultOutput.style.borderColor = '';

      const base = parseFloat(baseInput.value);
      const height = parseFloat(heightInput.value);

      try {
        const area = calculateTriangleArea(base, height);

        // Éxito
        resultOutput.style.display = 'flex';
        resultOutput.textContent = `The area is: ${area}`;
        // Estilo de éxito (puedes mover esto a CSS si prefieres clases)
        resultOutput.style.borderColor = 'var(--brand-ts)';
        resultOutput.style.backgroundColor = '#eef2ff';

      } catch (error) {
        // Error
        resultOutput.style.display = 'flex';
        resultOutput.textContent = (error as Error).message;
        resultOutput.style.borderColor = 'red';
        resultOutput.style.backgroundColor = '#ffeef0';
      }
    });
  }
  })
  
</script>

<style>
  /* Pequeño ajuste local para agrupar label+input si hiciera falta */
  .form__group {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .main__result:empty {
    display: none;
  }
</style>